rules_version = '2';

// MERGED firestore.rules — reconciles three versions written across Phase 2
// and Phase 4. Decisions made at merge:
//   1. Base logic = Phase 2's (correctly scoped individuals create/update).
//      Phase 4's version left create/update ungated by area/mandal for
//      scoped-only volunteers — that gap is closed here.
//   2. Each match block computes volunteer+role context via ONE `let c =
//      ctx();` inside a single combined function, instead of calling
//      hasPermission()/hasAnyPermission() multiple times per allow line
//      (each of which re-ran ctx()'s two get() calls independently in the
//      original Phase 2 draft). Firestore caps get()/exists() at 10 per
//      request — this keeps every rule well under that ceiling.
//      NOTE: `let` is only valid inside a function body ending in `return`
//      (Firestore rules functions: "single return statement" + "in rules
//      version v2, functions can define variables using let") — it cannot
//      be used inline inside an `allow ... : if (...)` condition directly,
//      which is why every check below is wrapped in a named function.
//   3. Phase 4's `batches` collection rules are added (new in Phase 4).
//
// PHASE 21 — scopeKind. `assignedAreas` OR `assignedMandals` used to be the
// only shape these rules could express. It is now one of six (see
// src/lib/scope.js, which this file mirrors function for function):
//   global · area · mandal · intersect · union · none
// The shape is read from the ROLE document (`scopeKind`); the values stay on
// the volunteer.
//
// PHASE 23 — when neither the volunteer nor the role states a shape, ctx() now
// DERIVES it from the assignment (both an area and a mandal → 'intersect', one
// axis → that axis) instead of falling back to 'union'. 'union' is area OR
// mandal, the widest shape short of global, so every role saved before Phase 21
// silently granted a karyakarta their whole area PLUS their mandal city-wide.
// Keep this in step with inferScopeKind() in src/lib/scope.js: if the two ever
// disagree the database wins, silently, by returning empty lists.
//
// PHASE 23b — a 'union' stored on a ROLE document is only honoured when the role
// also carries `scopeKindChosen: true`. Older builds re-wrote scopeKind on every
// save from a helper that reported an unset shape as 'union', so roles nobody had
// scoped ended up looking as if UNION had been chosen on purpose.
// Mirrors roleStatedScopeKind() in src/lib/scope.js. The volunteer's own stamp is
// NOT discounted the same way: for a multi-role holder it is the only shape this
// file can see, and dropping it could make the server NARROWER than the client,
// which surfaces as "Missing or insufficient permissions" on a legitimate write.
// Leaving it makes the server laxer than the UI until an admin re-saves that
// volunteer or the role's shape — the safe direction, and self-correcting.
//
// KNOWN AND DELIBERATE — two gaps, both forced by the rules language:
//   a) A volunteer may hold SEVERAL roles (roleRefs[]). ctx() cannot iterate an
//      array doing a get() per element (10 get()/exists() per request, no
//      map/reduce), so it reads `roleRef`, which the client writes as the MOST
//      SENIOR of the held roles. The rules therefore enforce a CONSERVATIVE
//      SUBSET of what the UI grants — never more.
//   b) individuals READ is permission-only, not scope-checked. Rules cannot see
//      a query's constraints, so any scope predicate on `resource.data` would
//      make every list query fail outright rather than return fewer rows.
//      Contact-level scoping for reads is enforced client-side in
//      lib/scope.js. Writes, deletes and household reads ARE scope-checked here.
//
// ASSUMPTION (unchanged from both source files): volunteers/{id} doc ID ===
// request.auth.uid. See src/hooks/usePermissions.jsx for the client-side
// mirror of this assumption.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Helpers
    // ---------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function volunteerExists() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/volunteers/$(request.auth.uid));
    }

    // Bundles volunteer + role lookups into one function so callers pay the
    // get() cost once per invocation, not once per field accessed. Always
    // call this exactly ONCE per allow-line (assign to a local `let c`),
    // never call it from inside a loop of independent permission checks.
    //
    // HARD LIMIT: a rules function may declare at most TEN `let` bindings.
    // This one is at nine. Adding a tenth is fine; an eleventh fails the whole
    // deploy with "Maximum allowed variable count of 10 for a given function
    // has been reached" pointing at the closing line, not at what you added.
    // Fold new logic into an existing ternary rather than naming a new local.
    function ctx() {
      let v = get(/databases/$(database)/documents/volunteers/$(request.auth.uid)).data;
      // Every save path writes BOTH `roleRefs` (the real list) and `roleRef`
      // (the primary, mirrored for this file — rules cannot loop over a list or
      // merge permissions from several role documents, so only one can be read).
      // The fallback covers documents that predate the mirror or were imported
      // directly: without it such a volunteer resolves to perms:[] and is denied
      // everything, which looks exactly like a broken role rather than a
      // missing field.
      let rid = (('roleRef' in v) && v.roleRef != null && v.roleRef != '') ? v.roleRef
        : ((('roleRefs' in v) && (v.roleRefs is list) && v.roleRefs.size() > 0) ? v.roleRefs[0] : '');
      let r = (rid != '') ? get(/databases/$(database)/documents/roles/$(rid)).data : {};

      // `is list` / `is string`, not just `in`: a malformed field would otherwise
      // make .size() or a comparison below raise an error, and an error in a rule
      // is a denial with no message — the hardest failure in this file to debug.
      let areas = (('assignedAreas' in v) && (v.assignedAreas is list)) ? v.assignedAreas : [];
      let mandalsRaw = (('assignedMandals' in v) && (v.assignedMandals is list)) ? v.assignedMandals : [];
      // PHASE 32 — mandals worked by the same people. Bal Mandal and Sishu Mandal
      // share one set of volunteers, so holding either grants both. This mirrors
      // MANDAL_GROUPS / expandMandalGroups() in src/lib/scope.js and must be
      // changed with it: if the client widens and this does not, the UI offers
      // Sishu Mandal and the database refuses the write. Contacts keep their own
      // mandal value — this widens WHO MAY SEE them, nothing else.
      let mandals = mandalsRaw.hasAny(['Bal Mandal', 'Sishu Mandal'])
        ? mandalsRaw.concat(['Bal Mandal', 'Sishu Mandal'])
        : mandalsRaw;
      // The volunteer's own `scopeKind` wins when present: with SEVERAL roles
      // the UI honours the WIDEST of their shapes, and this file can only read
      // one role document, so Admin → Volunteers stamps the resolved shape on
      // the volunteer (see VolunteerEditor.handleSave). Only a manage_users
      // holder can write that field — the same trust level as changing
      // roleRef — so it opens no new escalation path. Falls back to the role
      // document, and then to the inference below.
      let vk = (('scopeKind' in v) && (v.scopeKind is string)) ? v.scopeKind : '';
      // PHASE 23b — a stored 'union' on the ROLE is only trusted when the role
      // also carries `scopeKindChosen: true`. Builds before Phase 23 rewrote
      // `scopeKind` on EVERY save using a helper that reported an unset shape as
      // 'union', so renaming a role or ticking one checkbox permanently stamped
      // the widest shape short of global onto roles nobody had ever scoped.
      // `scopeKindChosen` is written only by a save that actually STATES a shape —
      // the Scope picker, a preset, or a merge — so it tells a deliberate UNION
      // apart from that accident. Mirrors roleStatedScopeKind() in
      // src/lib/scope.js. Every other shape is trusted either way: union is the
      // only value that was ever written by accident.
      let rk = (('scopeKind' in r) && (r.scopeKind is string)) ? r.scopeKind : '';
      let stated = (vk != '') ? vk
        : ((rk == 'union' && !(('scopeKindChosen' in r) && (r.scopeKindChosen == true))) ? '' : rk);
      return {
        'perms': ('permissions' in r) ? r.permissions : [],
        'areas': areas,
        'mandals': mandals,
        // PHASE 23 — when NOBODY has stated a shape, derive it from what this
        // volunteer actually holds, exactly as inferScopeKind() does on the
        // client. This used to fall back to 'union' (area OR mandal), which is the
        // widest shape short of global: a karyakarta holding one area and one
        // mandal was granted their whole area PLUS their mandal across the entire
        // city. Holding both now means the cell where the two cross.
        // Fully parenthesised — the rules parser is fussy about chained ternaries.
        'kind': (stated != '') ? stated
          : ((areas.size() > 0 && mandals.size() > 0) ? 'intersect'
            : ((areas.size() > 0) ? 'area'
              : ((mandals.size() > 0) ? 'mandal' : 'union'))),
      };
    }

    // The AND-vs-OR decision, in one place. `inArea` / `inMandal` are already
    // evaluated by the caller (each axis is cheap for one of them and needs a
    // household get() for the other, so the caller decides how to obtain them).
    //
    // This is the server mirror of matchesScope() in src/lib/scope.js:
    //   global    → everything          area   → the area row
    //   mandal    → the mandal column   intersect → the single cell (AND)
    //   union     → either axis (OR)    none   → nothing
    function scopeAllows(c, inArea, inMandal) {
      return c.perms.hasAny(['view_all_contacts']) ||
        c.kind == 'global' ||
        (c.kind == 'area' && inArea) ||
        (c.kind == 'mandal' && inMandal) ||
        (c.kind == 'intersect' && inArea && inMandal) ||
        (c.kind == 'union' && (inArea || inMandal));
    }

    // ---------------------------------------------------------------------
    // roles/{id}: name, permissions[]
    // Read is open to any signed-in volunteer — restricting it would break
    // every other rule's permission lookup for non-admins, since ctx()
    // needs to read the caller's own role doc to resolve their permissions.
    // ---------------------------------------------------------------------

    function canManageRoles() {
      let c = ctx();
      return c.perms.hasAny(['manage_roles']);
    }

    match /roles/{roleId} {
      allow read: if isSignedIn();
      allow write: if volunteerExists() && canManageRoles();
    }

    // ---------------------------------------------------------------------
    // volunteers/{id}: name, mobile, roleRef, assignedAreas[], assignedMandals[]
    // ---------------------------------------------------------------------

    function canManageUsers() {
      let c = ctx();
      return c.perms.hasAny(['manage_users']);
    }

    // PHASE 21 — a Moderator (Area head) / Super Moderator (Mandal head) fixes
    // the details of the karyakartas under them without holding manage_users,
    // which is effectively full control (it can change anyone's role, including
    // its own). Deliberately strict, in three ways:
    //   • the target's territory must be a SUBSET of the editor's, on the axis
    //     the editor's own role is shaped by — checked on the document BEFORE
    //     and AFTER the write, so nobody can be lifted out of scope;
    //   • kind 'global' is not accepted here. A role that should edit every
    //     volunteer is a role that should hold manage_users;
    //   • roleRef/roleRefs are untouchable, so this can never grant permissions,
    //     and neither is scopeKind — writing 'global' there would otherwise be a
    //     one-field escalation from "my area" to "every area".
    function volunteerSubsetOk(data, c) {
      let areas = (('assignedAreas' in data) && data.assignedAreas != null) ? data.assignedAreas : [];
      let mandals = (('assignedMandals' in data) && data.assignedMandals != null) ? data.assignedMandals : [];
      // size() > 0 matters: [].hasOnly(anything) is true, which would make a
      // volunteer with no territory yet editable by every moderator.
      let inArea = areas.size() > 0 && areas.hasOnly(c.areas);
      let inMandal = mandals.size() > 0 && mandals.hasOnly(c.mandals);
      return (c.kind == 'area' && inArea) ||
        (c.kind == 'mandal' && inMandal) ||
        (c.kind == 'intersect' && inArea && inMandal) ||
        (c.kind == 'union' && (inArea || inMandal));
    }

    function canManageScopedVolunteer(oldData, newData) {
      let c = ctx();
      return c.perms.hasAny(['manage_scoped_volunteers']) &&
        !newData.diff(oldData).affectedKeys().hasAny(['roleRef', 'roleRefs', 'scopeKind']) &&
        volunteerSubsetOk(oldData, c) &&
        volunteerSubsetOk(newData, c);
    }

    match /volunteers/{volunteerId} {
      // Any signed-in volunteer can read the full volunteer list
      allow read: if volunteerExists();

      // Admins can do anything
      allow create, delete: if volunteerExists() && canManageUsers();

      // Allow volunteers to update their OWN document, ONLY IF they are exclusively updating
      // safe tracking fields (lastLoginAt, lastSeenAt, profilePhotoURL, usage).
      //
      // PHASE 24 — `usage` is this device's own Firestore read/write tally for the
      // day, written by the existing heartbeat in usePermissions.jsx so the Admin
      // Tools usage dashboard can total the team's spend without a write of its
      // own. It is self-reported and advisory: a volunteer could put any number
      // there, which is harmless because nothing is authorised by it. Leaving it
      // off this list would make the heartbeat itself fail, taking the "online
      // now" indicator with it.
      allow update: if volunteerExists() && (
        canManageUsers() ||
        canManageScopedVolunteer(resource.data, request.resource.data) ||
        (
          request.auth.uid == volunteerId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLoginAt', 'lastSeenAt', 'profilePhotoURL', 'usage'])
        )
      );
    }

    // ---------------------------------------------------------------------
    // households/{id}: address, area, level, totalFamilyMembers,
    //   samparkKaryakartaName, samparkKaryakartaNumber, remark, legacyId,
    //   createdAt, updatedAt
    // ---------------------------------------------------------------------

    // PHASE 21 — mirrors filterHouseholdsByScope() in src/lib/scope.js.
    // A household has an `area` but NO mandal of its own, so a Mandal head is
    // allowed every household: their people live all over the city, and hiding
    // the household would hide the only route to its members. Every other
    // scoped shape is decided by the household's area.
    function householdScopeOk(data, c) {
      return c.perms.hasAny(['view_all_contacts']) ||
        c.kind == 'global' ||
        c.kind == 'mandal' ||
        (c.kind != 'none' && ('area' in data) && data.area in c.areas);
    }

    function canReadHousehold(data) {
      let c = ctx();
      return c.perms.hasAny(['view_all_contacts']) ||
        (c.perms.hasAny(['view_assigned_contacts']) && householdScopeOk(data, c));
    }

    function canCreateHousehold(data) {
      let c = ctx();
      return c.perms.hasAny(['edit_contacts']) && householdScopeOk(data, c);
    }

    function canUpdateHousehold(oldData, newData) {
      let c = ctx();
      return c.perms.hasAny(['edit_contacts']) &&
        householdScopeOk(oldData, c) && householdScopeOk(newData, c);
    }

    function canDeleteHousehold(data) {
      let c = ctx();
      return c.perms.hasAny(['delete_contacts', 'manage_users']) &&
        householdScopeOk(data, c);
    }

    match /households/{householdId} {
      allow read: if volunteerExists() && canReadHousehold(resource.data);
      allow create: if volunteerExists() && canCreateHousehold(request.resource.data);
      allow update: if volunteerExists() && canUpdateHousehold(resource.data, request.resource.data);
      allow delete: if volunteerExists() && canDeleteHousehold(resource.data);
    }

    // ---------------------------------------------------------------------
    // individuals/{id}: householdId, name, mobile, dob, dobMonthDay,
    //   anniversary, anniversaryMonthDay, mandal, relation, isPrimary,
    //   profilePhotoURL, status, reference, callCount, createdAt, updatedAt
    //
    // PHASE 27 adds `lastRound`, a map holding the frozen verdict of the calling
    // round just gone: { eventId, eventDate, eventTitle, status, reference,
    // attended, cleared, closedAt }. Written only by closeRound() and only for
    // contacts that were actually called. There is no field whitelist on this
    // collection, so it needs no rules change — noted here because a reader of
    // these rules would otherwise not know the field exists.
    //
    // individuals don't carry `area` directly — only their parent household
    // does — so a scoped check also looks at the household (Phase 16 standalone
    // contacts are the exception and carry their own).
    //
    // MERGE FIX: Phase 4's rules left create/update ungated by area/mandal
    // for scoped volunteers. Fixed below by applying the same scoping used
    // for read to create and update as well.
    //
    // PHASE 21: that scoping is no longer a fixed OR — see individualScopeOk.
    // Both axes are now evaluated and scopeAllows() decides whether the role
    // wants either (union), one (area / mandal) or both (intersect).
    // ---------------------------------------------------------------------

    // Standalone contacts (no household — see Phase 13) have data.householdId
    // == null but may now carry their own `area` field directly (Phase 16),
    // so scoping checks that first before falling back to a household lookup.
    function individualArea(data) {
      let own = (('area' in data) && data.area != null) ? data.area : null;
      let hid = (('householdId' in data) && data.householdId != null) ? data.householdId : null;
      // The get() only runs when the individual has no area of its own AND has
      // a household that exists — 2 lookups worst case, on top of ctx()'s 2.
      let hh = (own == null && hid != null &&
        exists(/databases/$(database)/documents/households/$(hid)))
        ? get(/databases/$(database)/documents/households/$(hid)).data
        : {};
      return own != null ? own : (('area' in hh) ? hh.area : null);
    }

    // PHASE 21 — this used to be a fixed OR of (mandal, own area, household
    // area). That is the 'union' shape and only the 'union' shape: it let a
    // karyakarta scoped to ONE mandal in ONE area write to every household in
    // their area and to every member of their mandal city-wide. The shape now
    // comes from the role, and 'intersect' means AND — the single cell of the
    // area × mandal grid, which is what a plain karyakarta actually holds.
    // The 'in' checks are guarded because a doc may lack the field entirely
    // (the old code read data.mandal unguarded, which errors on such docs).
    function individualScopeOk(data, c) {
      let mandal = (('mandal' in data) && data.mandal != null) ? data.mandal : null;
      let inMandal = mandal != null && mandal in c.mandals;
      let area = individualArea(data);
      let inArea = area != null && area in c.areas;
      return scopeAllows(c, inArea, inMandal);
    }

    // PHASE 25 — used in four places: the importer creates contacts and sabhas,
    // and Undo deletes the ones it created. Declared here because it is needed
    // above the importRuns block that documents it.
    function canImportData() {
      let c = ctx();
      return c.perms.hasAny(['import_data']);
    }

    // A document this import created, and therefore one its own Undo may remove.
    // `get` with a default because everything predating Phase 21 lacks the field.
    function isImported(data) {
      return data.get('source', '') == 'history-import';
    }

    // READ IS NOT SCOPED, AND THAT IS DELIBERATE — read the next paragraph
    // before "fixing" it.
    //
    // Firestore allows a QUERY only if it can prove every document the query
    // could return is readable, without looking at any of them. A scope test
    // here would therefore not filter the list — it would make every
    // collection query in the app fail outright, because `individuals` is read
    // as a whole collection and narrowed in the client (lib/scope.js). Scoping
    // reads properly means moving the app to per-scope queries first.
    //
    // So this takes no `data`: the permission is the whole decision. Writes ARE
    // scoped below, which is what stops a scoped volunteer from changing
    // anything outside their territory.
    function canReadIndividual() {
      let c = ctx();
      return c.perms.hasAny(['view_all_contacts', 'view_assigned_contacts', 'edit_contacts']);
    }

    // create / update. `import_data` is accepted alongside `edit_contacts`
    // because the CSV importer writes contacts in bulk and is a separate grant.
    function canWriteIndividual(data) {
      let c = ctx();
      return c.perms.hasAny(['edit_contacts', 'import_data']) &&
        individualScopeOk(data, c);
    }

    // On update BOTH versions are checked, so a scoped volunteer cannot move a
    // contact into — or out of — someone else's area/mandal.
    function canUpdateIndividual(oldData, newData) {
      let c = ctx();
      return c.perms.hasAny(['edit_contacts', 'import_data']) &&
        individualScopeOk(oldData, c) && individualScopeOk(newData, c);
    }

    // PHASE 25 — import_data may delete a contact the IMPORT created, so that
    // whoever can start a half import can also reverse it. Without this, undoing
    // needed delete_contacts, and the role that caused the mess could not clean
    // it up. Contacts that existed before the import lack the marker and are
    // untouchable here, which is the point: undo must not mean "delete part of
    // my database".
    function canDeleteIndividual(data) {
      let c = ctx();
      return (c.perms.hasAny(['delete_contacts', 'manage_users']) ||
          (c.perms.hasAny(['import_data']) && isImported(data))) &&
        individualScopeOk(data, c);
    }

    match /individuals/{individualId} {
      allow read: if volunteerExists() && canReadIndividual();
      allow create: if volunteerExists() && canWriteIndividual(request.resource.data);
      allow update: if volunteerExists() && canUpdateIndividual(resource.data, request.resource.data);
      allow delete: if volunteerExists() && canDeleteIndividual(resource.data);
    }

    // ---------------------------------------------------------------------
    // activity/{id}: timestamp, volunteerId, individualId, action, details
    // Append-only audit log — no client-side edits or deletes, ever.
    // ---------------------------------------------------------------------

    function canReadActivity() {
      let c = ctx();
      return c.perms.hasAny(['view_all_contacts', 'view_assigned_contacts']);
    }

    match /activity/{activityId} {
      allow read: if volunteerExists() && canReadActivity();
      allow create: if volunteerExists() && request.resource.data.volunteerId == request.auth.uid;
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------------
    // batches/{id}: name, batchNumber, area, mandal, individualIds[],
    //   assignedVolunteerId, createdBy, createdAt   (Phase 4; area × mandal
    //   generation added in Phase 21)
    //
    // READ stays permission-only, on purpose. subscribeToBatches() listens to
    // the whole collection (orderBy createdAt would hide the Phase 4 documents
    // that predate the field), and a per-document scope predicate makes
    // Firestore reject a collection-wide listen outright rather than return
    // fewer rows — scoped volunteers would see an error instead of their own
    // batches. Which batches a volunteer SEES is decided by
    // filterBatchesByScope() in src/services/batchService.js, which also always
    // shows a volunteer the batch assigned to them. Writes are scoped here.
    // ---------------------------------------------------------------------

    function canReadBatches() {
      let c = ctx();
      return c.perms.hasAny(['view_all_contacts', 'view_assigned_contacts']);
    }

    // A batch's area/mandal may be null, which means "spans everything". For a
    // scoped volunteer that is BROADER than their own territory, so it is
    // correctly refused: cutting or reassigning a city-wide batch is an admin
    // act. Legacy batches with no `mandal` therefore need an admin to edit,
    // which is the conservative side to err on.
    function batchScopeOk(data, c) {
      let a = (('area' in data) && data.area != null) ? data.area : null;
      let m = (('mandal' in data) && data.mandal != null) ? data.mandal : null;
      return scopeAllows(c, a != null && a in c.areas, m != null && m in c.mandals);
    }

    // generate_batches (cut new batches) is a separate grant from
    // assign_batches (hand an existing batch to someone) — see
    // src/constants/permissions.js. Either one may write here.
    function canWriteBatch(data) {
      let c = ctx();
      return c.perms.hasAny(['assign_batches', 'generate_batches']) &&
        batchScopeOk(data, c);
    }

    match /batches/{batchId} {
      allow read: if volunteerExists() && canReadBatches();
      allow create: if volunteerExists() && canWriteBatch(request.resource.data);
      // Both versions checked so a batch cannot be pushed out of the editor's
      // own scope by the same write that edits it.
      allow update: if volunteerExists() &&
        canWriteBatch(resource.data) && canWriteBatch(request.resource.data);
      allow delete: if volunteerExists() && canWriteBatch(resource.data);
    }

    // ---------------------------------------------------------------------
    // events/{id}: title, date, time, durationMinutes, speaker, mandal,
    //   area, createdBy, createdAt, updatedAt   (Phase 6)
    // ---------------------------------------------------------------------

    function eventScopeAllows(data, c) {
      let inArea = ('area' in data) && data.area != null && data.area in c.areas;
      let inMandal = ('mandal' in data) && data.mandal != null && data.mandal in c.mandals;
      return scopeAllows(c, inArea, inMandal);
    }

    function canReadEvents() {
      let c = ctx();
      return c.perms.hasAny(['view_all_contacts', 'view_assigned_contacts']);
    }

    function canReadEvent(data) {
      let c = ctx();
      return c.perms.hasAny(['view_all_contacts', 'view_assigned_contacts']) &&
        eventScopeAllows(data, c);
    }

    function canManageEvent(data) {
      let c = ctx();
      return c.perms.hasAny(['manage_events']) && eventScopeAllows(data, c);
    }

    // PHASE 25 — import_data may CREATE a sabha, but not edit or delete one.
    // runHistoryImport() (src/services/historyImportService.js) materialises one
    // event per date column in the sheet, so a role holding only "Import
    // Contacts & History" was refused on the very FIRST write of the import —
    // while the same grant was already accepted for the contacts those sabhas
    // are about (see canWriteIndividual). Editing and deleting existing sabhas
    // stays manage_events: an import has no business rewriting the calendar
    // that is already in place.
    function canCreateEvents(data) {
      let c = ctx();
      return c.perms.hasAny(['import_data']) ||
        (c.perms.hasAny(['manage_events']) && eventScopeAllows(data, c));
    }

    match /events/{eventId} {
      allow read: if volunteerExists() && canReadEvent(resource.data);
      allow create: if volunteerExists() && canCreateEvents(request.resource.data);
      // Check both versions so an in-scope event cannot be moved into another
      // mandal by the same update.
      allow update: if volunteerExists() &&
        canManageEvent(resource.data) && canManageEvent(request.resource.data);
      // Undo deletes the sabhas the import created. Everything else stays
      // manage_events — an importer must not be able to remove a sabha somebody
      // organised in the app.
      allow delete: if volunteerExists() &&
        (canManageEvent(resource.data) || (canImportData() && isImported(resource.data)));
    }

    // ---------------------------------------------------------------------
    // sabhaSchedules/{scheduleId}: area, mandal, dayOfWeek, time,
    //   intervalWeeks, startDate, endDate, durationMinutes, speaker, title,
    //   active, createdBy, createdAt, updatedAt   (Phase 33)
    //
    // A schedule is a RULE that manufactures ordinary events/{id} documents; it
    // grants nothing by itself. Writing one is therefore exactly as privileged
    // as creating the sabhas it will produce, and canManageEvent() already asks
    // the right question of a document carrying `area` and `mandal` — so it is
    // reused verbatim rather than given a parallel set of helpers that could
    // drift out of step with the events rules above.
    //
    // READ IS UNSCOPED, on purpose and for the same reason as attendance: the
    // app subscribes to the whole collection and narrows client-side, and
    // Firestore evaluates a list query's rule per returned document — one
    // out-of-scope schedule would fail the entire query with permission-denied
    // rather than filtering it out. The collection is one small document per
    // (area, mandal) pair and holds no contact data; the events it produces
    // remain individually scoped by the block above, which is where the real
    // boundary is.
    // ---------------------------------------------------------------------
    match /sabhaSchedules/{scheduleId} {
      allow read: if volunteerExists() && canReadEvents();
      allow create: if volunteerExists() && canManageEvent(request.resource.data);
      // Both versions, so a schedule cannot be dragged into a mandal the caller
      // does not hold by the same update that saves it.
      allow update: if volunteerExists() &&
        canManageEvent(resource.data) && canManageEvent(request.resource.data);
      // Deleting the rule leaves the sabhas it already created alone — the
      // service deletes this document only, never a cascade.
      allow delete: if volunteerExists() && canManageEvent(resource.data);
    }

    // ---------------------------------------------------------------------
    // attendance/{eventId_individualId}: eventId, individualId, status,
    // ---------------------------------------------------------------------
    // attendance/{eventId_individualId}: eventId, individualId, status,
    //   markedBy, markedAt   (Phase 6)
    //
    // Marking present uses edit_contacts (same permission level as editing
    // a contact's Sampark status) — NOT manage_events, since any karyekar
    // running the calling flow at a Sabha needs to mark people present, not
    // just event organizers. The attendance TIME WINDOW is enforced only
    // client-side (see src/lib/attendanceWindow.js) — see that file's
    // comment for why it isn't duplicated here as a server-side check.
    // ---------------------------------------------------------------------

    function canMarkAttendance() {
      let c = ctx();
      // PHASE 21 — manage_attendance is the dedicated grant ("Mark Sabha
      // Attendance"), added so a role can mark presence WITHOUT being able to
      // edit contact records. edit_contacts still works, so no existing role
      // loses the ability it has today.
      //
      // PHASE 25 — import_data too. The history importer's entire output is
      // attendance rows; it was being refused by the one rule most central to
      // what it does.
      return c.perms.hasAny(['edit_contacts', 'manage_attendance', 'import_data']);
    }

    match /attendance/{attendanceId} {
      // Attendance is queried as one collection listener and Firestore cannot
      // prove a per-row parent-event lookup for that query. The Events page
      // filters the rows by the already scoped event list before displaying
      // them; event documents themselves remain the access boundary above.
      allow read: if volunteerExists() && canReadEvents();
      allow create, delete: if volunteerExists() && canMarkAttendance();
      // PHASE 25 — this was `allow update: if false`, on the reasoning that
      // presence is a create/delete toggle and is never edited in place. True of
      // the app's own marking (markPresent creates, unmarkPresent deletes) — but
      // NOT of the history importer, which set()s the deterministic ID
      // `${eventId}_${individualId}` on purpose, so that a second run overwrites
      // instead of duplicating. Firestore evaluates a set() over an EXISTING
      // document as an update, so every re-import — and every sabha where
      // somebody had already been marked by hand in the app — died partway
      // through with permission-denied. That is what the "Firestore refused the
      // write" toast on Admin Tools → Import History was actually reporting, and
      // no amount of fixing the role could have cleared it.
      //
      // An update is allowed only when it does not repoint the mark at a
      // different sabha or a different person, which is what `if false` was
      // really protecting: a mark may be rewritten, never moved.
      allow update: if volunteerExists() && canMarkAttendance() &&
        request.resource.data.eventId == resource.data.eventId &&
        request.resource.data.individualId == resource.data.individualId;
    }

    // ---------------------------------------------------------------------
    // importRuns/{id}: kind, fileName, status, startedBy, startedAt,
    //   finishedAt, events, contacts, marks, error   (Phase 25)
    //
    // One row per attempt at Admin Tools → Import Sabha History. It is what
    // makes Undo possible: a refused write rejects a whole 450-operation
    // WriteBatch atomically, so a failed import leaves part of itself committed,
    // and reversing that needs to know which documents came from WHICH run.
    //
    // Never deleted, only marked `undone`. An admin reading this tab later has to
    // be able to tell "that import was reversed" from "that import never
    // happened" — particularly when the reversal was itself interrupted.
    // ---------------------------------------------------------------------

    // canImportData() is declared up with the individuals helpers — the importer
    // creates contacts and sabhas, so the gate is needed above this block.

    match /importRuns/{runId} {
      // Readable by anyone who can see the audit trail: a half import is
      // something a moderator may need to explain without being able to cause one.
      allow read: if volunteerExists() && canReadActivity();
      allow create, update: if volunteerExists() && canImportData();
      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // areas/{id}: name, code   |   mandals/{id}: name, code   (Phase 11)
    // Read open to any signed-in volunteer (dropdowns need them everywhere).
    // Write gated by manage_users — same admin tier as volunteer management,
    // rather than inventing a new permission for a rarely-changed table.
    // ---------------------------------------------------------------------

    match /areas/{areaId} {
      allow read: if volunteerExists();
      allow write: if volunteerExists() && canManageUsers();
    }

    match /mandals/{mandalId} {
      allow read: if volunteerExists();
      allow write: if volunteerExists() && canManageUsers();
    }

    match /levels/{levelId} {
      allow read: if volunteerExists();
      allow write: if volunteerExists() && canManageUsers();
    }

    // ---------------------------------------------------------------------
    // padhramani/{id}: householdId, scheduledDate, assignedVolunteerId,
    //   area, status, notes, createdAt, updatedAt
    // Read: any volunteer who can view contacts.
    // Write: any volunteer who can edit contacts.
    // ---------------------------------------------------------------------

    function canReadPadhramani() {
      let c = ctx();
      return c.perms.hasAny(['view_all_contacts', 'view_assigned_contacts', 'edit_contacts', 'manage_users']);
    }

    function canWritePadhramani() {
      let c = ctx();
      return c.perms.hasAny(['edit_contacts', 'manage_users', 'view_all_contacts']);
    }

    function canDeletePadhramani() {
      let c = ctx();
      return c.perms.hasAny(['delete_contacts', 'manage_users', 'edit_contacts']);
    }

    match /padhramani/{visitId} {
      allow read: if volunteerExists() && canReadPadhramani();
      allow create, update: if volunteerExists() && canWritePadhramani();
      allow delete: if volunteerExists() && canDeletePadhramani();
    }

    // padhramaniEvents/{id}: name, scheduledDate, volunteer fields, households[], status
    // Read/write open to any registered volunteer — no area-scoping needed
    // since Padhramani is coordinated at the org level, not per-area.
    match /padhramaniEvents/{eventId} {
      allow read: if volunteerExists();
      allow create, update: if volunteerExists();
      allow delete: if volunteerExists() && canManageUsers();
    }

    // ---------------------------------------------------------------------
    // campaigns/{id}: name, isActive
    // ---------------------------------------------------------------------

    match /campaigns/{campaignId} {
      allow read: if volunteerExists();
      allow write: if volunteerExists() && canManageUsers();
    }

    // ---------------------------------------------------------------------
    // settings/{docId} (Phase 20): three singleton documents —
    //   settings/email           → automation toggles, sender, dryRun,
    //                              maxRecipients, extraRecipients[]
    //   settings/messageTemplate → the WhatsApp message template
    //   settings/callOutcomes    → the calling screen's outcome buttons
    //
    // messageTemplate and callOutcomes are read by every volunteer on the
    // calling screen — settings/messageTemplate is loaded per contact to build
    // the WhatsApp link — so a permission check there would silently strip the
    // button for exactly the people who need it. Read stays open for those.
    //
    // PHASE 22 — settings/email is NOT one of them, and used to be. It holds
    // `extraRecipients[]`: the personal email addresses of sanchalaks, trustees
    // and accountants who receive the reports without ever signing in. Those
    // people are not app users and did not hand their address to 21 karyakartas;
    // it was readable by every one of them, and by anything with a volunteer
    // login. It also exposes `fromAddress` and the dryRun/maxRecipients config,
    // which together tell an attacker exactly how the outbox is wired.
    //
    // Nothing on the volunteer-facing side reads it: the only reader is
    // src/components/admin-tools/EmailAutomationTab.jsx, and AdminToolsPage
    // already gates that tab on send_emails. So the read gate below is a strict
    // superset of who could reach the screen — no volunteer loses anything.
    //
    // IMPORTANT for describeSettingsError() in src/services/settingsService.js:
    // it distinguishes "rules not deployed" from "role lacks manage_templates"
    // by whether the READ was also denied, which relies on reads being
    // unrestricted. That still holds for anyone who can open the Report Emails
    // tab, because that tab requires send_emails and send_emails is accepted
    // here. Keep those two in step if either changes.
    // ---------------------------------------------------------------------

    function canManageTemplates() {
      let c = ctx();
      return c.perms.hasAny(['manage_templates']);
    }

    function canSeeEmailSettings() {
      let c = ctx();
      return c.perms.hasAny(['send_emails', 'manage_templates', 'manage_users']);
    }

    match /settings/{docId} {
      allow read: if volunteerExists() && (docId != 'email' || canSeeEmailSettings());
      allow write: if volunteerExists() && canManageTemplates();
    }

    // ---------------------------------------------------------------------
    // passwordResets/{mobile} (Phase 22): "I'm locked out, please reset me".
    //
    // Replaces the old self-service reset, which was callable by anyone and set
    // the password to the mobile number the caller typed — see the header of
    // functions/resetVolunteerPassword.js. A row here changes nothing; an admin
    // with manage_users has to approve it and type the new password.
    //
    // CREATE IS CLOSED TO EVERY CLIENT. The document is written by the
    // requestPasswordReset callable through the Admin SDK, which bypasses these
    // rules, and only after confirming the number belongs to an active
    // volunteer. If clients could create rows, anyone could fabricate a request
    // in another volunteer's name and wait for an admin to approve it — turning
    // the approval step into the very hole it was added to close.
    //
    // Read is admin-only: the row carries a volunteer's name and mobile, and the
    // list of who is currently locked out is not everyone's business. Update and
    // delete are allowed so the admin screen can deny or clear a request without
    // needing a callable for it.
    // ---------------------------------------------------------------------

    match /passwordResets/{mobile} {
      allow read, update, delete: if volunteerExists() && canManageUsers();
      allow create: if false;
    }

    // ---------------------------------------------------------------------
    // emailLogs/{id} (Phase 20): one row per report the scheduler tried to
    // send — queued / dry-run / skipped, with the recipient list.
    //
    // Written only by Cloud Functions through the Admin SDK, which bypasses
    // these rules entirely, so client writes are refused outright. Being
    // able to read them is the same trust level as being able to trigger a
    // send, hence send_emails.
    // ---------------------------------------------------------------------

    function canSeeEmailLogs() {
      let c = ctx();
      return c.perms.hasAny(['send_emails', 'manage_users']);
    }

    match /emailLogs/{logId} {
      allow read: if volunteerExists() && canSeeEmailLogs();
      allow write: if false;
    }

    // ---------------------------------------------------------------------
    // mail/{id} (Phase 20): the outbox consumed by the Firebase "Trigger
    // Email from Firestore" extension.
    //
    // Closed to every client, in both directions. A writable outbox is an
    // open relay — any authenticated volunteer could mail arbitrary HTML to
    // arbitrary addresses from the temple's domain. Only the Admin SDK (in
    // functions/lib/mailer.js) writes here, and only the extension reads.
    // ---------------------------------------------------------------------

    match /mail/{mailId} {
      allow read, write: if false;
    }
  }
}
